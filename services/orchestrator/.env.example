# Orchestrator Server Configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# AI Provider Selection (options: 'deepgram'/'mock', 'gemini'/'mock', 'elevenlabs'/'mock', 'simli'/'mock')
STT_PROVIDER=deepgram
TRANSLATION_PROVIDER=gemini
TTS_PROVIDER=elevenlabs
