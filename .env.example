# ========================================================
# Live AI Translator & Dubbing - Environment Configuration
# ========================================================

# Orchestrator Server Configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# AI Provider Selection
# Options for STT: 'deepgram', 'mock'
# Options for Translation: 'gemini', 'mock'
# Options for TTS: 'elevenlabs', 'mock'
# Options for LipSync: 'simli', 'mock'
STT_PROVIDER=deepgram
TRANSLATION_PROVIDER=gemini
TTS_PROVIDER=elevenlabs
LIPSYNC_PROVIDER=simli

# Deepgram Nova-2 API Key (https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Voice Cloning API Key (https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Simli Real-Time WebRTC Lip-Sync API Key (https://simli.com)
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=default_avatar
